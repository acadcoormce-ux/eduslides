<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduSlides - Interactive Presentation Hub</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        /* Custom scrollbar for better visual feel */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="h-full flex flex-col text-slate-800 antialiased selection:bg-indigo-500 selection:text-white">

    <!-- Top Navigation Bar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
            <!-- Logo & Brand -->
            <div class="flex items-center gap-3">
                <button id="mobile-menu-toggle" class="md:hidden text-slate-600 hover:text-indigo-600 focus:outline-none p-1">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
                <div class="flex items-center gap-2 cursor-pointer" onclick="resetToHome()">
                    <div class="bg-indigo-600 text-white p-2 rounded-xl shadow-md shadow-indigo-200">
                        <i class="fa-solid fa-file-powerpoint text-xl"></i>
                    </div>
                    <div>
                        <span class="font-bold text-xl tracking-tight bg-gradient-to-r from-indigo-600 to-violet-600 bg-clip-text text-transparent">EduSlides</span>
                        <span class="text-xs text-slate-400 block -mt-1 font-medium">Free Presentation Resources</span>
                    </div>
                </div>
            </div>

            <!-- Global Search Bar -->
            <div class="flex-1 max-w-md hidden sm:block">
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="global-search" placeholder="Search topics, subjects, or keywords..." 
                        class="w-full pl-10 pr-4 py-2 bg-slate-100 hover:bg-slate-50 focus:bg-white text-sm border border-transparent focus:border-indigo-500 rounded-xl transition duration-150 outline-none">
                </div>
            </div>

            <!-- Quick Action Buttons -->
            <div class="flex items-center gap-2">
                <button id="bookmarks-btn" class="relative p-2 text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-xl transition flex items-center gap-1.5 text-sm font-medium">
                    <i class="fa-solid fa-bookmark text-amber-500"></i>
                    <span class="hidden md:inline">Bookmarks</span>
                    <span id="bookmark-count" class="bg-indigo-600 text-white text-xs font-bold px-1.5 py-0.5 rounded-full">0</span>
                </button>
                <button onclick="openInfoModal()" class="p-2 text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-xl transition">
                    <i class="fa-solid fa-circle-info text-lg"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Search Bar (Visible only on tiny screens) -->
        <div class="px-4 pb-3 sm:hidden border-t border-slate-100 pt-2">
            <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="text" id="global-search-mobile" placeholder="Search topics or keywords..." 
                    class="w-full pl-10 pr-4 py-2 bg-slate-100 text-sm rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <div class="flex-1 max-w-7xl w-full mx-auto flex overflow-hidden">
        
        <!-- Sidebar Navigation (Grade Levels) -->
        <aside id="sidebar" class="w-64 bg-white border-r border-slate-200 flex-shrink-0 flex flex-col justify-between hidden md:flex z-20">
            <div class="p-4 overflow-y-auto">
                <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3 px-3">Grade Levels</h2>
                <nav id="grade-list" class="space-y-1">
                    <!-- Grade Level buttons injected via JS -->
                </nav>
            </div>
            <!-- Footer Info box -->
            <div class="p-4 border-t border-slate-100 bg-slate-50/50">
                <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-3 text-xs text-indigo-900">
                    <div class="font-semibold mb-1"><i class="fa-solid fa-cloud-arrow-down mr-1"></i> Free Teacher Resources</div>
                    <p class="text-indigo-700/80">All PowerPoint presentations are editable and free to download for educational use.</p>
                </div>
            </div>
        </aside>

        <!-- Overlay for Mobile Sidebar -->
        <div id="mobile-overlay" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-10 hidden md:hidden"></div>

        <!-- Main Workspace Area -->
        <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50">
            
            <!-- Navigation Path / Breadcrumb -->
            <nav class="flex items-center text-sm font-medium text-slate-500 mb-6 flex-wrap gap-2" id="breadcrumb-nav">
                <span class="hover:text-indigo-600 cursor-pointer" onclick="resetToHome()">Home</span>
                <i class="fa-solid fa-chevron-right text-xs text-slate-300"></i>
                <span id="breadcrumb-grade" class="text-slate-800 font-semibold">Select Grade</span>
                <span id="breadcrumb-subject-wrapper" class="hidden flex items-center gap-2">
                    <i class="fa-solid fa-chevron-right text-xs text-slate-300"></i>
                    <span id="breadcrumb-subject" class="text-indigo-600 font-semibold">Subject</span>
                </span>
            </nav>

            <!-- Dynamic Header Banner -->
            <div id="header-banner" class="bg-gradient-to-r from-indigo-600 to-violet-600 rounded-2xl p-6 mb-8 text-white shadow-lg shadow-indigo-100 relative overflow-hidden">
                <div class="relative z-10">
                    <span id="banner-tag" class="bg-white/20 text-white text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider mb-2 inline-block backdrop-blur-md">Overview</span>
                    <h1 id="banner-title" class="text-2xl sm:text-3xl font-extrabold tracking-tight">Welcome to EduSlides Presentation Portal</h1>
                    <p id="banner-description" class="mt-2 text-indigo-100 max-w-2xl text-sm sm:text-base">Select a grade level from the sidebar to start browsing free, fully customizable classroom PowerPoint decks!</p>
                </div>
                <!-- Decorative background shapes -->
                <div class="absolute -right-8 -bottom-12 opacity-10 text-9xl font-bold select-none pointer-events-none">
                    <i class="fa-solid fa-file-powerpoint"></i>
                </div>
            </div>

            <!-- Main Content Grid / List Area -->
            <section id="main-content">
                <!-- Content will dynamically switch between:
                     1. Subject Grid View
                     2. PowerPoint Presentations List View
                     3. Bookmarks View
                     4. Search Results View
                -->
            </section>
        </main>
    </div>

    <!-- Presentation Preview Modal -->
    <div id="preview-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-3xl w-full max-h-[90vh] flex flex-col shadow-2xl overflow-hidden border border-slate-100">
            <!-- Modal Header -->
            <div class="p-4 sm:p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                <div class="flex items-center gap-3">
                    <div id="modal-subject-badge" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-indigo-100 text-indigo-700">Mathematics</div>
                    <span id="modal-grade-badge" class="text-xs font-medium text-slate-500">Grade 4</span>
                </div>
                <button onclick="closePreviewModal()" class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg hover:bg-slate-200/50 transition">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <!-- Modal Content -->
            <div class="p-6 overflow-y-auto space-y-6">
                <!-- Fake Slide Preview Screen -->
                <div class="aspect-video bg-slate-900 rounded-xl overflow-hidden relative shadow-inner flex flex-col justify-between p-6 text-white border border-slate-800 group">
                    <div class="flex justify-between items-start">
                        <span class="text-xs tracking-wider text-slate-400 uppercase font-semibold">Slide Preview (1 of 12)</span>
                        <div class="flex gap-1.5">
                            <span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span>
                            <span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span>
                            <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span>
                        </div>
                    </div>

                    <div class="my-auto text-center px-4">
                        <h2 id="modal-slide-title" class="text-2xl sm:text-3xl font-extrabold text-amber-400 mb-2">Topic Title</h2>
                        <p id="modal-slide-sub" class="text-slate-300 text-sm max-w-lg mx-auto">Interactive Presentation Slides for Classroom Learning</p>
                    </div>

                    <div class="flex justify-between items-center text-xs text-slate-400">
                        <span>EduSlides Resource Center</span>
                        <span>Standard 16:9 Format</span>
                    </div>
                </div>

                <!-- Presentation Metadata -->
                <div>
                    <h3 id="modal-title" class="text-xl font-bold text-slate-900">Presentation Title</h3>
                    <p id="modal-desc" class="text-sm text-slate-600 mt-2 leading-relaxed">Comprehensive slide deck covering fundamental principles with diagrams and class activity prompts.</p>
                </div>

                <!-- Slide Specs Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 border-t border-slate-100">
                    <div class="bg-slate-50 p-3 rounded-xl">
                        <div class="text-xs text-slate-400">Slides Count</div>
                        <div id="modal-slides-count" class="font-bold text-slate-700 mt-0.5">14 Slides</div>
                    </div>
                    <div class="bg-slate-50 p-3 rounded-xl">
                        <div class="text-xs text-slate-400">File Size</div>
                        <div id="modal-file-size" class="font-bold text-slate-700 mt-0.5">4.2 MB</div>
                    </div>
                    <div class="bg-slate-50 p-3 rounded-xl">
                        <div class="text-xs text-slate-400">Format</div>
                        <div class="font-bold text-indigo-600 mt-0.5">PPTX / PDF</div>
                    </div>
                    <div class="bg-slate-50 p-3 rounded-xl">
                        <div class="text-xs text-slate-400">Downloads</div>
                        <div id="modal-downloads" class="font-bold text-slate-700 mt-0.5">1,240</div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer / Actions -->
            <div class="p-4 sm:p-5 border-t border-slate-100 bg-slate-50 flex flex-wrap gap-3 justify-between items-center">
                <button id="modal-bookmark-btn" class="px-4 py-2.5 rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-100 font-semibold text-sm transition flex items-center gap-2">
                    <i class="fa-regular fa-bookmark"></i>
                    <span>Bookmark</span>
                </button>
                <div class="flex gap-2 w-full sm:w-auto">
                    <button onclick="simulateDownload('.pdf')" class="flex-1 sm:flex-none px-4 py-2.5 rounded-xl border border-indigo-200 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold text-sm transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-file-pdf"></i>
                        <span>PDF</span>
                    </button>
                    <button onclick="simulateDownload('.pptx')" class="flex-1 sm:flex-none px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition shadow-md shadow-indigo-200 flex items-center justify-center gap-2">
                        <i class="fa-solid fa-download"></i>
                        <span>Download PPTX</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Info / How-to Modal -->
    <div id="info-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl relative">
            <button onclick="closeInfoModal()" class="absolute right-4 top-4 text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
            <div class="flex items-center gap-3 mb-4">
                <div class="bg-indigo-100 text-indigo-600 p-3 rounded-xl">
                    <i class="fa-solid fa-chalkboard-user text-xl"></i>
                </div>
                <div>
                    <h3 class="font-bold text-lg text-slate-900">How to Create Your Own Free Site</h3>
                    <p class="text-xs text-slate-500">Building this website for free</p>
                </div>
            </div>
            <div class="space-y-3 text-sm text-slate-600 mb-6">
                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <strong class="text-slate-800 block mb-0.5">1. Free Hosting Options:</strong>
                    Use GitHub Pages, Vercel, or Netlify to host standard HTML/CSS/JS or React apps 100% free.
                </div>
                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <strong class="text-slate-800 block mb-0.5">2. File Storage for Presentations:</strong>
                    Upload PowerPoint files (`.pptx` or `.pdf`) to Google Drive or Dropbox and paste the shareable download links in your site data!
                </div>
                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <strong class="text-slate-800 block mb-0.5">3. Website Builders:</strong>
                    If you prefer no-code: Google Sites, Canva Websites, or Wix offer free tiers.
                </div>
            </div>
            <button onclick="closeInfoModal()" class="w-full py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-medium rounded-xl text-sm transition">
                Got it, thanks!
            </button>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toast" class="fixed bottom-5 right-5 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-xl flex items-center gap-3 transition-all duration-300 transform translate-y-20 opacity-0 z-50 text-sm">
        <i id="toast-icon" class="fa-solid fa-circle-check text-emerald-400"></i>
        <span id="toast-message">Notification message</span>
    </div>

    <script>
        /* Sample Application Data Store */
        const gradeLevels = [
            { id: 'g1', name: 'Grade 1', icon: 'fa-child', color: 'text-pink-500', bg: 'bg-pink-50' },
            { id: 'g2', name: 'Grade 2', icon: 'fa-cubes', color: 'text-amber-500', bg: 'bg-amber-50' },
            { id: 'g3', name: 'Grade 3', icon: 'fa-shapes', color: 'text-emerald-500', bg: 'bg-emerald-50' },
            { id: 'g4', name: 'Grade 4', icon: 'fa-compass', color: 'text-sky-500', bg: 'bg-sky-50' },
            { id: 'g5', name: 'Grade 5', icon: 'fa-seedling', color: 'text-indigo-500', bg: 'bg-indigo-50' },
            { id: 'g6', name: 'Grade 6', icon: 'fa-atom', color: 'text-purple-500', bg: 'bg-purple-50' },
            { id: 'hs', name: 'High School', icon: 'fa-graduation-cap', color: 'text-rose-500', bg: 'bg-rose-50' }
        ];

        const subjects = [
            { id: 'math', name: 'Mathematics', icon: 'fa-calculator', color: 'from-blue-500 to-indigo-600', description: 'Numbers, Geometry, Algebra & Problem Solving' },
            { id: 'sci', name: 'Science', icon: 'fa-flask', color: 'from-emerald-500 to-teal-600', description: 'Biology, Physics, Earth Science & Experiments' },
            { id: 'eng', name: 'English', icon: 'fa-book-open', color: 'from-amber-500 to-orange-600', description: 'Grammar, Reading Comprehension & Literature' },
            { id: 'soc', name: 'Social Studies', icon: 'fa-globe', color: 'from-purple-500 to-violet-600', description: 'History, Geography, Civics & Cultures' },
            { id: 'art', name: 'Art & Music', icon: 'fa-palette', color: 'from-pink-500 to-rose-600', description: 'Visual Arts, Music History & Creative Design' }
        ];

        // Sample generated presentation repository
        const presentationsData = [
            // Grade 1 Math
            { id: 101, gradeId: 'g1', subjectId: 'math', title: 'Introduction to Addition & Counting', desc: 'Fun interactive counting objects from 1 to 20 with colorful animal animations.', slides: 12, size: '3.4 MB', downloads: 1420, date: '2026-01-15' },
            { id: 102, gradeId: 'g1', subjectId: 'math', title: 'Basic Shapes around Us', desc: 'Recognizing circles, squares, triangles, and rectangles in everyday surroundings.', slides: 10, size: '2.8 MB', downloads: 980, date: '2026-02-02' },
            
            // Grade 1 Science
            { id: 103, gradeId: 'g1', subjectId: 'sci', title: 'Living vs Non-Living Things', desc: 'Understanding what plants and animals need to grow compared to toys and objects.', slides: 15, size: '4.1 MB', downloads: 2100, date: '2026-01-20' },

            // Grade 4 Math
            { id: 401, gradeId: 'g4', subjectId: 'math', title: 'Understanding Fractions & Decimals', desc: 'Visual models for pie fractions, improper fractions, and decimal conversions.', slides: 18, size: '5.2 MB', downloads: 3410, date: '2026-02-10' },
            { id: 402, gradeId: 'g4', subjectId: 'math', title: 'Multiplication Tables (6 to 12)', desc: 'Tips, tricks, and quick mental math practice drills for grade 4 students.', slides: 22, size: '6.0 MB', downloads: 4120, date: '2026-02-18' },
            
            // Grade 4 Science
            { id: 403, gradeId: 'g4', subjectId: 'sci', title: 'The Water Cycle Explained', desc: 'Evaporation, condensation, precipitation, and collection with animated diagrams.', slides: 16, size: '7.4 MB', downloads: 5200, date: '2026-03-01' },
            { id: 404, gradeId: 'g4', subjectId: 'sci', title: 'Ecosystems & Food Chains', desc: 'Producers, consumers, and decomposers in rainforest and ocean habitats.', slides: 20, size: '6.8 MB', downloads: 2890, date: '2026-02-25' },

            // High School Math
            { id: 701, gradeId: 'hs', subjectId: 'math', title: 'Quadratic Equations & Graphs', desc: 'Solving quadratics using factoring, quadratic formulas, and vertex graphing.', slides: 24, size: '8.1 MB', downloads: 1890, date: '2026-01-11' },
            // High School English
            { id: 702, gradeId: 'hs', subjectId: 'eng', title: 'Mastering Persuasive Essay Writing', desc: 'Structuring arguments, counterclaims, thesis statements, and rhetorical devices.', slides: 19, size: '4.5 MB', downloads: 2310, date: '2026-03-04' }
        ];

        /* State Variables */
        let activeGradeId = 'g4'; // Default initial selection
        let activeSubjectId = null;
        let bookmarkedIds = JSON.parse(localStorage.getItem('eduslides_bookmarks') || '[]');
        let currentModalPresentation = null;

        // Initialization on page load
        window.addEventListener('DOMContentLoaded', () => {
            renderSidebar();
            selectGrade('g4'); // Default set to Grade 4
            setupEventListeners();
            updateBookmarkBadge();
        });

        function setupEventListeners() {
            // Search listeners
            document.getElementById('global-search').addEventListener('input', handleSearch);
            document.getElementById('global-search-mobile').addEventListener('input', handleSearch);

            // Mobile menu toggle
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('mobile-overlay');
            const menuBtn = document.getElementById('mobile-menu-toggle');

            menuBtn.addEventListener('click', () => {
                sidebar.classList.toggle('hidden');
                sidebar.classList.toggle('fixed');
                sidebar.classList.toggle('inset-y-0');
                sidebar.classList.toggle('left-0');
                overlay.classList.toggle('hidden');
            });

            overlay.addEventListener('click', () => {
                sidebar.classList.add('hidden');
                sidebar.classList.remove('fixed', 'inset-y-0', 'left-0');
                overlay.classList.add('hidden');
            });

            // Bookmarks view toggle button
            document.getElementById('bookmarks-btn').addEventListener('click', renderBookmarksView);
        }

        // Render Grade Level Links in Sidebar
        function renderSidebar() {
            const container = document.getElementById('grade-list');
            container.innerHTML = gradeLevels.map(grade => `
                <button onclick="selectGrade('${grade.id}')" 
                    id="btn-grade-${grade.id}"
                    class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-medium text-sm transition text-slate-600 hover:bg-slate-100 hover:text-slate-900 group">
                    <div class="flex items-center gap-3">
                        <span class="w-7 h-7 rounded-lg ${grade.bg} ${grade.color} flex items-center justify-center text-xs font-bold group-hover:scale-110 transition-transform">
                            <i class="fa-solid ${grade.icon}"></i>
                        </span>
                        <span>${grade.name}</span>
                    </div>
                    <i class="fa-solid fa-chevron-right text-xs opacity-0 group-hover:opacity-100 text-slate-400 transition"></i>
                </button>
            `).join('');
        }

        // Select Grade Level Action
        function selectGrade(gradeId) {
            activeGradeId = gradeId;
            activeSubjectId = null;

            // Highlight Active Sidebar Item
            gradeLevels.forEach(g => {
                const btn = document.getElementById(`btn-grade-${g.id}`);
                if (btn) {
                    if (g.id === gradeId) {
                        btn.className = 'w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-semibold text-sm transition bg-indigo-50 text-indigo-700 shadow-sm';
                    } else {
                        btn.className = 'w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-medium text-sm transition text-slate-600 hover:bg-slate-100 hover:text-slate-900 group';
                    }
                }
            });

            // Update Breadcrumbs & Banner
            const grade = gradeLevels.find(g => g.id === gradeId);
            document.getElementById('breadcrumb-grade').textContent = grade.name;
            document.getElementById('breadcrumb-subject-wrapper').classList.add('hidden');

            document.getElementById('banner-tag').textContent = 'Grade Overview';
            document.getElementById('banner-title').textContent = `${grade.name} Presentations`;
            document.getElementById('banner-description').textContent = `Explore subject modules and download PowerPoint decks specifically formatted for ${grade.name} curriculum.`;

            // Close mobile menu if open
            document.getElementById('mobile-overlay').click();

            // Render Subjects View for this Grade
            renderSubjectsGrid();
        }

        // Render Subject Selection Cards
        function renderSubjectsGrid() {
            const container = document.getElementById('main-content');
            const grade = gradeLevels.find(g => g.id === activeGradeId);

            let html = `
                <div class="mb-4 flex items-center justify-between">
                    <h2 class="text-lg font-bold text-slate-800">Select Subject for ${grade.name}</h2>
                    <span class="text-xs text-slate-400 font-medium">${subjects.length} Subjects Available</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            `;

            html += subjects.map(sub => {
                // Count available presentations for this grade & subject
                const count = presentationsData.filter(p => p.gradeId === activeGradeId && p.subjectId === sub.id).length;
                
                return `
                    <div onclick="selectSubject('${sub.id}')" 
                        class="bg-white rounded-2xl p-6 border border-slate-200/80 hover:border-indigo-300 hover:shadow-xl hover:shadow-indigo-500/5 transition duration-200 cursor-pointer group flex flex-col justify-between">
                        <div>
                            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br ${sub.color} text-white flex items-center justify-center text-xl shadow-md mb-4 group-hover:scale-105 transition-transform">
                                <i class="fa-solid ${sub.icon}"></i>
                            </div>
                            <h3 class="text-lg font-bold text-slate-800 group-hover:text-indigo-600 transition-colors">${sub.name}</h3>
                            <p class="text-xs text-slate-500 mt-1 line-clamp-2 leading-relaxed">${sub.description}</p>
                        </div>
                        <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                            <span class="text-xs font-semibold ${count > 0 ? 'text-indigo-600 bg-indigo-50' : 'text-slate-400 bg-slate-100'} px-2.5 py-1 rounded-full">
                                ${count} Decks Available
                            </span>
                            <span class="text-xs font-bold text-indigo-600 group-hover:translate-x-1 transition-transform flex items-center gap-1">
                                View Decks <i class="fa-solid fa-arrow-right text-[10px]"></i>
                            </span>
                        </div>
                    </div>
                `;
            }).join('');

            html += `</div>`;
            container.innerHTML = html;
        }

        // Select Subject & Display PowerPoints
        function selectSubject(subjectId) {
            activeSubjectId = subjectId;
            const grade = gradeLevels.find(g => g.id === activeGradeId);
            const subject = subjects.find(s => s.id === subjectId);

            // Update Breadcrumb
            document.getElementById('breadcrumb-subject').textContent = subject.name;
            document.getElementById('breadcrumb-subject-wrapper').classList.remove('hidden');

            // Update Banner
            document.getElementById('banner-tag').textContent = `${grade.name} • ${subject.name}`;
            document.getElementById('banner-title').textContent = `${subject.name} Slide Decks`;
            document.getElementById('banner-description').textContent = `Download editable PPTX files for classroom teaching, quizzes, and visual discussions.`;

            renderPresentationsList();
        }

        // Render Presentations List Filtered by Grade & Subject
        function renderPresentationsList() {
            const container = document.getElementById('main-content');
            const items = presentationsData.filter(p => p.gradeId === activeGradeId && p.subjectId === activeSubjectId);
            const subject = subjects.find(s => s.id === activeSubjectId);

            if (items.length === 0) {
                container.innerHTML = `
                    <div class="bg-white rounded-2xl p-12 text-center border border-slate-200 max-w-lg mx-auto my-8">
                        <div class="w-16 h-16 bg-indigo-50 text-indigo-500 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                            <fa-solid class="fa-solid fa-folder-open"></fa-solid>
                        </div>
                        <h3 class="text-lg font-bold text-slate-800">No PowerPoints Yet</h3>
                        <p class="text-xs text-slate-500 mt-1 mb-6">We are adding new slide decks for this subject weekly!</p>
                        <button onclick="renderSubjectsGrid()" class="px-4 py-2 bg-indigo-600 text-white font-semibold text-xs rounded-xl shadow">Back to Subjects</button>
                    </div>
                `;
                return;
            }

            let html = `
                <div class="mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="flex items-center gap-2">
                        <button onclick="renderSubjectsGrid()" class="p-2 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 text-slate-600 transition" title="Back to Subjects">
                            <i class="fa-solid fa-arrow-left text-sm"></i>
                        </button>
                        <h2 class="text-lg font-bold text-slate-800">Available PowerPoint Presentations</h2>
                    </div>
                    <span class="text-xs text-slate-500 bg-white px-3 py-1.5 border border-slate-200 rounded-xl font-medium">
                        Showing ${items.length} Files
                    </span>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            `;

            html += items.map(p => createPresentationCard(p)).join('');
            html += `</div>`;
            container.innerHTML = html;
        }

        // Card component for PowerPoint deck
        function createPresentationCard(p) {
            const isBookmarked = bookmarkedIds.includes(p.id);
            const sub = subjects.find(s => s.id === p.subjectId);
            const grade = gradeLevels.find(g => g.id === p.gradeId);

            return `
                <div class="bg-white rounded-2xl border border-slate-200/80 hover:border-indigo-300 hover:shadow-lg transition duration-200 flex flex-col justify-between overflow-hidden group">
                    <div>
                        <!-- Slide Card Header / Visual Thumbnail -->
                        <div class="bg-slate-900 p-4 relative h-36 flex flex-col justify-between text-white overflow-hidden cursor-pointer" onclick="openPreviewModal(${p.id})">
                            <div class="flex justify-between items-center z-10">
                                <span class="bg-white/20 backdrop-blur-md text-white text-[10px] font-bold px-2 py-0.5 rounded-md uppercase tracking-wider">
                                    ${sub ? sub.name : 'Slide Deck'}
                                </span>
                                <button onclick="event.stopPropagation(); toggleBookmark(${p.id})" class="text-slate-300 hover:text-amber-400 transition p-1">
                                    <i class="fa-${isBookmarked ? 'solid' : 'regular'} fa-bookmark ${isBookmarked ? 'text-amber-400' : ''}"></i>
                                </button>
                            </div>
                            <div class="z-10">
                                <h4 class="font-bold text-amber-300 text-base leading-tight line-clamp-2">${p.title}</h4>
                                <span class="text-[11px] text-slate-300 mt-1 block">${grade ? grade.name : ''} Module</span>
                            </div>
                            <!-- Subtle PPT watermark icon -->
                            <i class="fa-solid fa-file-powerpoint absolute -right-3 -bottom-3 text-7xl text-white/5 group-hover:scale-110 transition-transform"></i>
                        </div>

                        <!-- Details -->
                        <div class="p-5">
                            <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed mb-4">${p.desc}</p>
                            
                            <div class="flex items-center justify-between text-xs text-slate-400 font-medium">
                                <span class="flex items-center gap-1"><i class="fa-solid fa-layer-group text-indigo-500"></i> ${p.slides} Slides</span>
                                <span class="flex items-center gap-1"><i class="fa-solid fa-hard-drive text-indigo-500"></i> ${p.size}</span>
                                <span class="flex items-center gap-1"><i class="fa-solid fa-download text-indigo-500"></i> ${p.downloads}</span>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons Footer -->
                    <div class="px-5 pb-5 pt-0 flex gap-2">
                        <button onclick="openPreviewModal(${p.id})" class="flex-1 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl transition flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-eye text-slate-500"></i> Preview
                        </button>
                        <button onclick="simulateDownload('.pptx')" class="flex-1 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-xl shadow-md shadow-indigo-100 transition flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-download"></i> Get PPTX
                        </button>
                    </div>
                </div>
            `;
        }

        // Global Search Handler
        function handleSearch(e) {
            const query = e.target.value.toLowerCase().trim();
            
            if (!query) {
                if (activeSubjectId) {
                    selectSubject(activeSubjectId);
                } else {
                    renderSubjectsGrid();
                }
                return;
            }

            // Sync other search bar input
            document.getElementById('global-search').value = query;
            document.getElementById('global-search-mobile').value = query;

            // Search matches in title or description
            const matches = presentationsData.filter(p => 
                p.title.toLowerCase().includes(query) || 
                p.desc.toLowerCase().includes(query)
            );

            // Update Header Banner
            document.getElementById('banner-tag').textContent = 'Search Results';
            document.getElementById('banner-title').textContent = `Search Query: "${query}"`;
            document.getElementById('banner-description').textContent = `Found ${matches.length} matching presentation files.`;

            const container = document.getElementById('main-content');
            if (matches.length === 0) {
                container.innerHTML = `
                    <div class="bg-white rounded-2xl p-12 text-center border border-slate-200 max-w-lg mx-auto my-8">
                        <div class="w-16 h-16 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </div>
                        <h3 class="text-lg font-bold text-slate-800">No Matching Decks Found</h3>
                        <p class="text-xs text-slate-500 mt-1 mb-4">Try typing different keywords like "Fractions", "Water Cycle", or "Addition".</p>
                    </div>
                `;
            } else {
                let html = `<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">`;
                html += matches.map(p => createPresentationCard(p)).join('');
                html += `</div>`;
                container.innerHTML = html;
            }
        }

        // Bookmark Toggle logic
        function toggleBookmark(id) {
            if (bookmarkedIds.includes(id)) {
                bookmarkedIds = bookmarkedIds.filter(bId => bId !== id);
                showToast('Removed from Bookmarks', 'info');
            } else {
                bookmarkedIds.push(id);
                showToast('Added to Bookmarks!', 'success');
            }
            
            localStorage.setItem('eduslides_bookmarks', JSON.stringify(bookmarkedIds));
            updateBookmarkBadge();

            // Refresh view if currently inside bookmarks screen
            if (document.getElementById('banner-tag').textContent === 'Saved Items') {
                renderBookmarksView();
            } else if (activeSubjectId) {
                renderPresentationsList();
            }

            // Sync modal bookmark button if open
            if (currentModalPresentation && currentModalPresentation.id === id) {
                updateModalBookmarkBtn();
            }
        }

        function updateBookmarkBadge() {
            document.getElementById('bookmark-count').textContent = bookmarkedIds.length;
        }

        // Render Bookmarked Presentations View
        function renderBookmarksView() {
            document.getElementById('banner-tag').textContent = 'Saved Items';
            document.getElementById('banner-title').textContent = 'My Bookmarked Presentations';
            document.getElementById('banner-description').textContent = 'Access your saved slide decks quickly for lesson planning.';

            const container = document.getElementById('main-content');
            const savedItems = presentationsData.filter(p => bookmarkedIds.includes(p.id));

            if (savedItems.length === 0) {
                container.innerHTML = `
                    <div class="bg-white rounded-2xl p-12 text-center border border-slate-200 max-w-lg mx-auto my-8">
                        <div class="w-16 h-16 bg-amber-50 text-amber-500 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                            <i class="fa-solid fa-bookmark"></i>
                        </div>
                        <h3 class="text-lg font-bold text-slate-800">No Bookmarks Saved</h3>
                        <p class="text-xs text-slate-500 mt-1 mb-4">Click the bookmark icon on any presentation card to save it here for fast access!</p>
                        <button onclick="resetToHome()" class="px-4 py-2 bg-indigo-600 text-white font-semibold text-xs rounded-xl shadow">Browse Presentations</button>
                    </div>
                `;
            } else {
                let html = `<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">`;
                html += savedItems.map(p => createPresentationCard(p)).join('');
                html += `</div>`;
                container.innerHTML = html;
            }
        }

        // Presentation Preview Modal Actions
        function openPreviewModal(id) {
            const p = presentationsData.find(item => item.id === id);
            if (!p) return;

            currentModalPresentation = p;
            const sub = subjects.find(s => s.id === p.subjectId);
            const grade = gradeLevels.find(g => g.id === p.gradeId);

            document.getElementById('modal-subject-badge').textContent = sub ? sub.name : 'General';
            document.getElementById('modal-grade-badge').textContent = grade ? grade.name : 'All Grades';
            document.getElementById('modal-slide-title').textContent = p.title;
            document.getElementById('modal-slide-sub').textContent = p.desc;
            document.getElementById('modal-title').textContent = p.title;
            document.getElementById('modal-desc').textContent = p.desc;
            document.getElementById('modal-slides-count').textContent = `${p.slides} Slides`;
            document.getElementById('modal-file-size').textContent = p.size;
            document.getElementById('modal-downloads').textContent = p.downloads.toLocaleString();

            updateModalBookmarkBtn();

            document.getElementById('preview-modal').classList.remove('hidden');
        }

        function updateModalBookmarkBtn() {
            if (!currentModalPresentation) return;
            const isBookmarked = bookmarkedIds.includes(currentModalPresentation.id);
            const btn = document.getElementById('modal-bookmark-btn');
            
            btn.onclick = () => toggleBookmark(currentModalPresentation.id);

            if (isBookmarked) {
                btn.className = "px-4 py-2.5 rounded-xl border border-amber-200 bg-amber-50 text-amber-700 font-semibold text-sm transition flex items-center gap-2";
                btn.innerHTML = `<i class="fa-solid fa-bookmark text-amber-500"></i> Bookmarked`;
            } else {
                btn.className = "px-4 py-2.5 rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-100 font-semibold text-sm transition flex items-center gap-2";
                btn.innerHTML = `<i class="fa-regular fa-bookmark"></i> Bookmark`;
            }
        }

        function closePreviewModal() {
            document.getElementById('preview-modal').classList.add('hidden');
            currentModalPresentation = null;
        }

        // Info Modal
        function openInfoModal() {
            document.getElementById('info-modal').classList.remove('hidden');
        }
        function closeInfoModal() {
            document.getElementById('info-modal').classList.add('hidden');
        }

        // Simulate File Download
        function simulateDownload(ext) {
            showToast(`Downloading presentation file (${ext})...`, 'success');
        }

        // Reset App Home State
        function resetToHome() {
            document.getElementById('global-search').value = '';
            document.getElementById('global-search-mobile').value = '';
            selectGrade('g4');
        }

        // Toast Feedback Alert
        function showToast(msg, type = 'success') {
            const toast = document.getElementById('toast');
            const icon = document.getElementById('toast-icon');
            const message = document.getElementById('toast-message');

            message.textContent = msg;
            if (type === 'success') {
                icon.className = 'fa-solid fa-circle-check text-emerald-400';
            } else {
                icon.className = 'fa-solid fa-circle-info text-sky-400';
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>
